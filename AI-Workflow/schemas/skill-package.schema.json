{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlled-agent-workflow.local/schemas/skill-package.schema.json",
  "title": "Skill Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "skill_id",
    "display_name",
    "version",
    "owner",
    "role_id",
    "category",
    "status",
    "entry",
    "rule_language",
    "load_policy",
    "selectors",
    "scopes",
    "dependencies",
    "conflicts",
    "precedence",
    "compatibility",
    "tests"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0" },
    "skill_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" },
    "display_name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "owner": { "type": "string", "minLength": 1 },
    "role_id": { "enum": ["developer", "review", "project-analyst", "module-analyst"] },
    "category": {
      "enum": [
        "capability",
        "technology",
        "task-technique",
        "project-policy",
        "review-check",
        "analysis-profile",
        "validation",
        "output"
      ]
    },
    "status": { "enum": ["draft", "active", "deprecated", "manual_review"] },
    "entry": { "$ref": "#/$defs/packageRelativePath" },
    "rule_language": { "const": "zh-TW" },
    "load_policy": {
      "enum": ["explicit_only", "explicit_or_conditional", "conditional", "manual_review"]
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "default": []
    },
    "selectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all", "any", "none"],
      "properties": {
        "all": { "$ref": "#/$defs/selectors" },
        "any": { "$ref": "#/$defs/selectors" },
        "none": { "$ref": "#/$defs/selectors" }
      }
    },
    "scopes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_ids", "module_ids"],
      "properties": {
        "project_ids": { "$ref": "#/$defs/stringList" },
        "module_ids": { "$ref": "#/$defs/stringList" }
      }
    },
    "dependencies": { "$ref": "#/$defs/stringList" },
    "conflicts": { "$ref": "#/$defs/stringList" },
    "precedence": { "type": "integer", "minimum": 0 },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_workflow_version", "maximum_workflow_major"],
      "properties": {
        "minimum_workflow_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        },
        "maximum_workflow_major": { "type": "integer", "minimum": 1 }
      }
    },
    "tests": {
      "type": "array",
      "items": { "$ref": "#/$defs/packageRelativePath" },
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  },
  "$defs": {
    "packageRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "selectors": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*=.+$" },
      "uniqueItems": true
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
