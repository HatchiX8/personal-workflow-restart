{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlled-agent-workflow.local/schemas/registry.schema.json",
  "title": "Workflow Registry",
  "type": "object",
  "required": ["schema_version", "registry_id", "source", "source_snapshot", "path_contract"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0" },
    "registry_id": { "enum": ["roles", "skills", "rule-bundles", "modules"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "inventory_version", "source_paths"],
      "properties": {
        "type": { "enum": ["canonical-inventory", "generated-skill-packages"] },
        "inventory_version": { "const": "1.0" },
        "source_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/safePath" } }
      }
    },
    "source_snapshot": { "$ref": "#/$defs/sourceSnapshot" },
    "path_contract": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "registry_id": { "const": "roles" } } },
      "then": {
        "required": ["roles"],
        "properties": { "roles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/role" } } }
      }
    },
    {
      "if": { "properties": { "registry_id": { "const": "skills" } } },
      "then": {
        "required": ["skills", "documentation_files", "unresolved_references"],
        "properties": { "skills": { "type": "array", "items": { "$ref": "#/$defs/skill" } } }
      }
    },
    {
      "if": { "properties": { "registry_id": { "const": "rule-bundles" } } },
      "then": {
        "required": ["dependency_contract", "readme_policy", "rules", "bundles"],
        "properties": {
          "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } },
          "bundles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/bundle" } }
        }
      }
    },
    {
      "if": { "properties": { "registry_id": { "const": "modules" } } },
      "then": {
        "required": ["modules"],
        "properties": { "modules": { "type": "array", "items": { "$ref": "#/$defs/module" } } }
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "files", "fingerprint"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "kind", "content_hash"],
            "properties": {
              "path": { "$ref": "#/$defs/safePath" },
              "kind": { "enum": ["file", "directory"] },
              "content_hash": { "$ref": "#/$defs/hash" }
            }
          }
        },
        "fingerprint": { "$ref": "#/$defs/hash" }
      }
    },
    "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "precedence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "rank"],
      "properties": { "source": { "type": "string", "minLength": 1 }, "rank": { "type": "integer", "minimum": 0 } }
    },
    "role": {
      "type": "object",
      "required": ["role_id", "display_name", "action", "supported_actions", "activation", "entry", "planner", "status", "aliases", "required_bundle_ids", "optional_bundle_ids", "source"],
      "properties": {
        "role_id": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
        "display_name": { "type": "string", "minLength": 1 },
        "action": { "enum": ["develop", "review", "analyze"] },
        "supported_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["develop", "review", "analyze"] }
        },
        "activation": { "enum": ["automatic", "explicit-only"] },
        "entry": { "$ref": "#/$defs/safePath" },
        "planner": { "$ref": "#/$defs/safePath" },
        "status": { "const": "active" },
        "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "required_bundle_ids": { "$ref": "#/$defs/dependencies" },
        "optional_bundle_ids": { "$ref": "#/$defs/dependencies" },
        "source": { "$ref": "#/$defs/safePath" }
      }
    },
    "skill": {
      "type": "object",
      "required": ["skill_id", "manifest_path", "path", "role_id", "category", "version", "owner", "status", "load_policy", "aliases", "selectors", "scopes", "dependencies", "conflicts", "precedence", "compatibility"],
      "properties": {
        "skill_id": { "type": "string", "minLength": 1 },
        "manifest_path": { "$ref": "#/$defs/safePath" },
        "path": { "$ref": "#/$defs/safePath" },
        "role_id": { "type": "string" },
        "category": { "enum": ["capability", "technology", "task-technique", "project-policy", "review-check", "analysis-profile", "validation", "output"] },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
        "owner": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "active", "deprecated", "manual_review"] },
        "load_policy": { "enum": ["explicit_only", "explicit_or_conditional", "conditional", "manual_review"] },
        "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "selectors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["all", "any", "none"],
          "properties": {
            "all": { "$ref": "#/$defs/dependencies" },
            "any": { "$ref": "#/$defs/dependencies" },
            "none": { "$ref": "#/$defs/dependencies" }
          }
        },
        "scopes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_ids", "module_ids"],
          "properties": {
            "project_ids": { "$ref": "#/$defs/dependencies" },
            "module_ids": { "$ref": "#/$defs/dependencies" }
          }
        },
        "dependencies": { "$ref": "#/$defs/dependencies" },
        "conflicts": { "$ref": "#/$defs/dependencies" },
        "precedence": { "$ref": "#/$defs/precedence" },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum_workflow_version", "maximum_workflow_major"],
          "properties": {
            "minimum_workflow_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
            "maximum_workflow_major": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "required": ["rule_id", "path", "category", "status", "load_policy", "role_ids", "required", "triggers", "dependencies", "precedence"],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/safePath" },
        "category": { "enum": ["bootstrap", "common", "role", "target", "skill", "reviewer", "output"] },
        "status": { "enum": ["active", "legacy", "manual_review"] },
        "load_policy": { "enum": ["host-entry", "required", "conditional", "manual_review"] },
        "role_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "required": { "type": "boolean" },
        "triggers": { "$ref": "#/$defs/dependencies" },
        "trigger_mode": { "enum": ["any", "all"] },
        "dependencies": { "$ref": "#/$defs/dependencies" },
        "precedence": { "$ref": "#/$defs/precedence" }
      }
    },
    "bundle": {
      "type": "object",
      "required": ["bundle_id", "status", "selection", "triggers", "rule_ids", "dependencies", "source"],
      "properties": {
        "bundle_id": { "type": "string", "minLength": 1 },
        "status": { "const": "active" },
        "selection": { "const": "all" },
        "triggers": { "$ref": "#/$defs/dependencies" },
        "trigger_mode": { "enum": ["any", "all"] },
        "rule_ids": { "$ref": "#/$defs/dependencies" },
        "dependencies": { "$ref": "#/$defs/dependencies" },
        "source": { "$ref": "#/$defs/safePath" }
      }
    },
    "module": {
      "type": "object",
      "required": ["module_id", "display_name", "aliases", "status", "project_bindings", "context_selection", "context_candidates"],
      "properties": {
        "module_id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "status": { "enum": ["active", "unresolved", "legacy"] },
        "project_bindings": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "context_selection": { "type": "object", "required": ["current_context", "auto_resolution"] },
        "context_candidates": { "type": "array", "items": { "type": "object", "required": ["context_id", "path", "target", "project_id", "status", "current", "binding_status", "load_policy"] } }
      }
    }
  }
}
