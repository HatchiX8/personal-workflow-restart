{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlled-agent-workflow.local/schemas/runtime-request.schema.json",
  "title": "Workflow Runtime Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "operation", "task_manifest"],
  "properties": {
    "protocol_version": { "const": "1.0" },
    "operation": { "enum": ["resolve-routing", "resolve-execution"] },
    "project_root": { "type": "string", "minLength": 1 },
    "task_manifest": { "$ref": "task-manifest.schema.json" },
    "role_plan": { "$ref": "role-plan.schema.json" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "operation": { "const": "resolve-execution" } },
        "required": ["operation"]
      },
      "then": { "required": ["role_plan"] }
    }
  ]
}
