{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlled-agent-workflow.local/schemas/task-risk-policy.schema.json",
  "title": "Task Risk Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "default_level",
    "hard_triggers",
    "trigger_aliases",
    "derived_hard_triggers",
    "level_1"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0" },
    "default_level": { "const": 2 },
    "hard_triggers": {
      "type": "array",
      "items": { "$ref": "task-risk.schema.json#/$defs/hardTrigger" },
      "minItems": 1,
      "uniqueItems": true
    },
    "trigger_aliases": {
      "type": "object",
      "additionalProperties": { "$ref": "task-risk.schema.json#/$defs/hardTrigger" }
    },
    "derived_hard_triggers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_mode", "target_mode", "task_type"],
      "properties": {
        "scope_mode": { "$ref": "#/$defs/triggerMap" },
        "target_mode": { "$ref": "#/$defs/triggerMap" },
        "task_type": { "$ref": "#/$defs/triggerMap" }
      }
    },
    "level_1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_modes", "target_mode", "target_count", "task_types"],
      "properties": {
        "scope_modes": {
          "type": "array",
          "items": { "const": "file" },
          "minItems": 1,
          "uniqueItems": true
        },
        "target_mode": { "const": "single" },
        "target_count": { "const": 1 },
        "task_types": {
          "type": "array",
          "items": { "enum": ["change", "bugfix", "maintenance"] },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "triggerMap": {
      "type": "object",
      "additionalProperties": { "$ref": "task-risk.schema.json#/$defs/hardTrigger" }
    }
  }
}
