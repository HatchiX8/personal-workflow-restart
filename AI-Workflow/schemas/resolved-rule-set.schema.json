{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlled-agent-workflow.local/schemas/resolved-rule-set.schema.json",
  "title": "Resolved Rule Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resolution_id", "task_id", "generated_at", "role_id", "executor_entry", "rules", "contexts", "dependencies", "conflicts", "unresolved", "fingerprint", "status"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0" },
    "resolution_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "role_id": { "type": "string", "minLength": 1 },
    "executor_entry": { "type": "string", "minLength": 1 },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "contexts": { "type": "array", "items": { "$ref": "#/$defs/context" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "conflicts": { "type": "array", "items": { "type": "string" } },
    "unresolved": { "type": "array", "items": { "type": "string" } },
    "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "status": { "enum": ["resolved", "incomplete"] }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "category", "path", "required", "load_order", "precedence_rank", "reason", "registry_source", "content_hash"],
      "properties": {
        "rule_id": { "type": "string" },
        "category": { "enum": ["common", "role", "target", "skill", "reviewer", "output"] },
        "path": { "type": "string" },
        "required": { "type": "boolean" },
        "load_order": { "type": "integer", "minimum": 0 },
        "precedence_rank": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string" },
        "registry_source": { "type": "string" },
        "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_id", "type", "project_id", "module_id", "targets", "path_base", "path", "required", "status", "reason", "content_hash"],
      "properties": {
        "context_id": { "type": "string" },
        "type": { "enum": ["project", "module"] },
        "project_id": { "type": "string" },
        "module_id": { "type": ["string", "null"] },
        "targets": { "type": "array", "items": { "enum": ["frontend", "backend", "database", "tooling", "docs"] }, "uniqueItems": true },
        "path_base": { "enum": ["workflow_root", "project_root"] },
        "path": { "type": "string" },
        "required": { "type": "boolean" },
        "status": { "enum": ["current", "stale", "partial", "unknown"] },
        "reason": { "type": "string" },
        "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
