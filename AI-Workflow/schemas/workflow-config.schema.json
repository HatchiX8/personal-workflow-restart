{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlled-agent-workflow.local/schemas/workflow-config.schema.json",
  "title": "Workflow Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "workflow_version",
    "bootstrap",
    "orchestration",
    "registries",
    "schemas",
    "execution_profiles",
    "runtime",
    "confidence_policy",
    "runtime_policy"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0" },
    "workflow_id": { "type": "string", "minLength": 1 },
    "workflow_version": { "type": "string", "minLength": 1 },
    "bootstrap": { "$ref": "#/$defs/workflowRelativePath" },
    "orchestration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dispatcher", "task_manifest_authoring", "runtime_dispatch", "role_plan_authoring", "error_interpretation", "task_analysis", "task_risk_policy", "risk_assessment", "execution_profile_resolution", "role_planner", "result_reporting", "rule_resolution", "context_resolution", "preflight", "executor_adapter", "role_entry_contract"],
      "properties": {
        "dispatcher": { "$ref": "#/$defs/workflowRelativePath" },
        "task_manifest_authoring": { "$ref": "#/$defs/workflowRelativePath" },
        "runtime_dispatch": { "$ref": "#/$defs/workflowRelativePath" },
        "role_plan_authoring": { "$ref": "#/$defs/workflowRelativePath" },
        "error_interpretation": { "$ref": "#/$defs/workflowRelativePath" },
        "task_analysis": { "$ref": "#/$defs/workflowRelativePath" },
        "task_risk_policy": { "$ref": "#/$defs/workflowRelativePath" },
        "risk_assessment": { "$ref": "#/$defs/workflowRelativePath" },
        "execution_profile_resolution": { "$ref": "#/$defs/workflowRelativePath" },
        "role_planner": { "$ref": "#/$defs/workflowRelativePath" },
        "result_reporting": { "$ref": "#/$defs/workflowRelativePath" },
        "rule_resolution": { "$ref": "#/$defs/workflowRelativePath" },
        "context_resolution": { "$ref": "#/$defs/workflowRelativePath" },
        "preflight": { "$ref": "#/$defs/workflowRelativePath" },
        "executor_adapter": { "$ref": "#/$defs/workflowRelativePath" },
        "role_entry_contract": { "$ref": "#/$defs/workflowRelativePath" }
      }
    },
    "registries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "skills", "rule_bundles", "modules"],
      "properties": {
        "roles": { "$ref": "#/$defs/workflowRelativePath" },
        "skills": { "$ref": "#/$defs/workflowRelativePath" },
        "rule_bundles": { "$ref": "#/$defs/workflowRelativePath" },
        "modules": { "$ref": "#/$defs/workflowRelativePath" }
      }
    },
    "schemas": {
      "type": "object",
      "minProperties": 1,
      "required": ["runtime_request", "runtime_result", "task_risk_policy", "task_risk", "execution_profile"],
      "additionalProperties": { "$ref": "#/$defs/workflowRelativePath" }
    },
    "execution_profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lightweight", "standard", "full"],
      "properties": {
        "lightweight": { "$ref": "#/$defs/workflowRelativePath" },
        "standard": { "$ref": "#/$defs/workflowRelativePath" },
        "full": { "$ref": "#/$defs/workflowRelativePath" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "entry", "risk_policy", "minimum_node_version", "input", "request_directory", "output", "network", "writes", "fallback"],
      "properties": {
        "protocol_version": { "const": "1.0" },
        "entry": { "$ref": "#/$defs/workflowRelativePath" },
        "risk_policy": { "$ref": "#/$defs/workflowRelativePath" },
        "minimum_node_version": {
          "type": "string",
          "pattern": "^>=[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "input": { "const": "request-file-json" },
        "request_directory": {
          "type": "string",
          "const": ".ai-workflow/runtime/requests"
        },
        "output": { "const": "stdout-json" },
        "network": { "const": false },
        "writes": {
          "type": "array",
          "maxItems": 0
        },
        "fallback": { "const": "user-confirmed-markdown" }
      }
    },
    "confidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["high_threshold", "medium_threshold", "candidate_gap_threshold", "required_routing_minimum"],
      "properties": {
        "high_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "medium_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "candidate_gap_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "required_routing_minimum": { "const": "high" }
      }
    },
    "runtime_policy": { "type": "object" }
  },
  "$defs": {
    "workflowRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
