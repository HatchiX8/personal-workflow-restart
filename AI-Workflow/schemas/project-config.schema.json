{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlled-agent-workflow.local/schemas/project-config.schema.json",
  "title": "Project Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "project_root",
    "workflow_compatibility",
    "project_contexts",
    "module_registry",
    "module_aliases",
    "auto_skills",
    "context_resolution",
    "context_policy"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0" },
    "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "project_root": { "$ref": "#/$defs/projectRelativePath" },
    "workflow_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_version", "maximum_major_version"],
      "properties": {
        "minimum_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "maximum_major_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "project_contexts": {
      "type": "array",
      "items": { "$ref": "#/$defs/projectContext" }
    },
    "module_registry": {
      "oneOf": [
        { "$ref": "#/$defs/projectRelativePath" },
        { "type": "null" }
      ]
    },
    "module_aliases": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "auto_skills": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "context_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_identity", "module_identity", "auto_load", "candidate_conflict", "cross_project_context"],
      "properties": {
        "project_identity": { "const": "verified-config-and-canonical-root" },
        "module_identity": { "const": "project_id+module_id_or_alias+targets" },
        "auto_load": { "const": "current-only" },
        "candidate_conflict": { "const": "blocked" },
        "cross_project_context": { "const": "blocked" }
      }
    },
    "context_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_project_context_for": {
          "$ref": "#/$defs/contextRequiredActions"
        },
        "require_module_context_for": {
          "$ref": "#/$defs/contextRequiredActions"
        },
        "allow_project_analysis_without_context": {
          "type": "boolean"
        },
        "status_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "current": { "const": "pass" },
            "stale": { "enum": ["warning", "blocked"] },
            "partial": { "enum": ["warning", "blocked"] },
            "unknown": { "enum": ["warning", "blocked"] },
            "required_context_failure": { "const": "blocked" }
          }
        },
        "high_risk_conditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "deprecated": true,
          "description": "Deprecated compatibility field. Runtime ignores this field and emits a diagnostic when present."
        }
      }
    }
  },
  "$defs": {
    "contextRequiredActions": {
      "type": "array",
      "items": { "enum": ["develop", "review", "analyze"] },
      "uniqueItems": true
    },
    "projectContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_id", "path", "status", "current", "targets"],
      "properties": {
        "context_id": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/projectRelativePath" },
        "status": { "enum": ["current", "stale", "partial", "unknown"] },
        "current": { "type": "boolean" },
        "targets": {
          "type": "array",
          "items": { "enum": ["frontend", "backend", "database", "tooling", "docs"] },
          "uniqueItems": true
        },
        "required_for": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "projectRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
