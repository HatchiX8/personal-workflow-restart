{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlled-agent-workflow.local/schemas/execution-profile.schema.json",
  "title": "Execution Profile Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "risk_level",
    "profile_id",
    "required_stages",
    "skipped_stages",
    "reasons",
    "upward_escalation",
    "status"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0" },
    "task_id": { "type": "string", "minLength": 1 },
    "risk_level": { "type": "integer", "minimum": 1, "maximum": 3 },
    "profile_id": { "enum": ["lightweight", "standard", "full"] },
    "required_stages": {
      "type": "array",
      "items": { "$ref": "#/$defs/stageId" },
      "uniqueItems": true
    },
    "skipped_stages": {
      "type": "array",
      "items": { "$ref": "#/$defs/stageId" },
      "uniqueItems": true
    },
    "reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "upward_escalation": { "const": true },
    "status": { "enum": ["selected", "blocked"] }
  },
  "$defs": {
    "stageId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "risk_level": { "const": 1 } }, "required": ["risk_level"] },
      "then": { "properties": { "profile_id": { "const": "lightweight" } } }
    },
    {
      "if": { "properties": { "risk_level": { "const": 2 } }, "required": ["risk_level"] },
      "then": { "properties": { "profile_id": { "const": "standard" } } }
    },
    {
      "if": { "properties": { "risk_level": { "const": 3 } }, "required": ["risk_level"] },
      "then": { "properties": { "profile_id": { "const": "full" } } }
    },
    {
      "if": { "properties": { "status": { "const": "selected" } }, "required": ["status"] },
      "then": { "properties": { "required_stages": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "status": { "const": "blocked" } }, "required": ["status"] },
      "then": { "properties": { "required_stages": { "maxItems": 0 } } }
    }
  ]
}

