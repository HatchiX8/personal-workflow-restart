{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlled-agent-workflow.local/schemas/task-risk.schema.json",
  "title": "Task Risk Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "assessed_at",
    "level",
    "confidence",
    "scope_mode",
    "target_mode",
    "task_type",
    "risk_facts",
    "hard_triggers",
    "reasons",
    "upward_escalation",
    "status",
    "unresolved"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0" },
    "task_id": { "type": "string", "minLength": 1 },
    "assessed_at": { "type": "string", "format": "date-time" },
    "level": { "type": "integer", "minimum": 1, "maximum": 3 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "scope_mode": {
      "enum": ["file", "module", "cross-module", "full-project", "unknown"]
    },
    "target_mode": {
      "enum": ["single", "fullstack", "mixed", "unknown"]
    },
    "task_type": {
      "enum": ["feature", "change", "bugfix", "refactor", "migration", "maintenance", "analysis", "unknown"]
    },
    "risk_facts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "hard_triggers": {
      "type": "array",
      "items": { "$ref": "#/$defs/hardTrigger" },
      "uniqueItems": true
    },
    "reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "upward_escalation": { "const": true },
    "status": { "enum": ["assessed", "needs-resolution"] },
    "unresolved": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "hardTrigger": {
      "enum": [
        "cross-module",
        "full-project",
        "fullstack",
        "mixed-target",
        "migration",
        "architecture-change",
        "runtime-migration",
        "framework-migration",
        "shared-library-multi-consumer",
        "database-schema",
        "data-migration",
        "bulk-data-change",
        "transaction-integrity",
        "authentication",
        "authorization",
        "security",
        "secrets-credentials",
        "sensitive-data",
        "payment",
        "monetary-flow",
        "public-api-contract",
        "sdk-contract",
        "event-contract",
        "webhook-contract",
        "production-deployment",
        "infrastructure-change",
        "distributed-concurrency",
        "destructive-operation",
        "file-delete",
        "mass-move-or-rewrite",
        "git-history-rewrite",
        "rollback",
        "external-system-write",
        "workflow-governance-change"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "hard_triggers": { "minItems": 1 } },
        "required": ["hard_triggers"]
      },
      "then": {
        "properties": { "level": { "const": 3 } }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "assessed" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "unresolved": { "maxItems": 0 } }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "needs-resolution" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "unresolved": { "minItems": 1 } }
      }
    }
  ]
}
