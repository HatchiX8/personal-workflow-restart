{
  "$schema": "../schemas/task-risk-policy.schema.json",
  "schema_version": "1.0",
  "default_level": 2,
  "hard_triggers": [
    "cross-module",
    "full-project",
    "fullstack",
    "mixed-target",
    "migration",
    "architecture-change",
    "runtime-migration",
    "framework-migration",
    "shared-library-multi-consumer",
    "database-schema",
    "data-migration",
    "bulk-data-change",
    "transaction-integrity",
    "authentication",
    "authorization",
    "security",
    "secrets-credentials",
    "sensitive-data",
    "payment",
    "monetary-flow",
    "public-api-contract",
    "sdk-contract",
    "event-contract",
    "webhook-contract",
    "production-deployment",
    "infrastructure-change",
    "distributed-concurrency",
    "destructive-operation",
    "file-delete",
    "mass-move-or-rewrite",
    "git-history-rewrite",
    "rollback",
    "external-system-write",
    "workflow-governance-change"
