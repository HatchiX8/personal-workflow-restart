      "specified_role": true,
      "specified_skill": true,
      "prompt": "角色：developer\nSkill：developer.language.typescript\n\n調整 Vue 前端訂單列表元件的 TypeScript 資料型別，不要改變功能行為。",
      "expected": {
        "action": "develop",
        "role_id": "developer",
        "planner_entry": "roles/developer/planner.md",
        "targets": ["frontend"],
        "required_skill_ids": [
          "developer.language.typescript",
          "developer.frontend.base"
        ],
        "conditional_skill_ids": ["developer.frontend.vue"],
        "forbidden_role_ids": ["review", "project-analyst", "module-analyst"]
      }
    },
    {
      "scenario_id": "accept-review-explicit-role-auto-skill",
      "specified_role": true,
